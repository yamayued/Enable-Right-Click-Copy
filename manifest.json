{
  "manifest_version": 3,
  "name": "Enable Right Click & Copy",
  "version": "1.0",
  "description": "すべてのウェブサイトで右クリックとコピー&ペーストを有効化",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enable Right Click & Copy"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png"
  }
}